{
  "name": "topic-hunter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "wxt",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "biome lint entrypoints src tests wxt.config.ts",
    "test": "vitest run tests/*.test.ts",
    "test:e2e": "pnpm build && playwright test",
    "build": "wxt build -b chrome",
    "zip": "wxt zip -b chrome"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.12",
    "idb": "8.0.3",
    "lucide-react": "1.45.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@playwright/test": "1.63.0",
    "@types/chrome": "0.2.9",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.1",
    "fake-indexeddb": "6.2.5",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "wxt": "0.21.4"
  }
}
